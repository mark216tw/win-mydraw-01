<Window
    x:Class="Com.StudentTools.MyDraw.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Com.StudentTools.MyDraw.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="RootLayout"
        Background="{ThemeResource AppBackgroundBrush}"
        IsTabStop="True"
        KeyDown="RootLayout_KeyDown"
        KeyUp="RootLayout_KeyUp">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="UndoAccelerator_Invoked" />
            <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="RedoAccelerator_Invoked" />
            <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" Invoked="RedoAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopBarRow" Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ToolColumn" Width="52" />
            <ColumnDefinition x:Name="WorkspaceColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 最上方系統選單列 + 右側精簡狀態區 -->
        <Border
            x:Name="TopBar"
            Grid.ColumnSpan="2"
            Padding="4,0,8,0"
            Background="{ThemeResource PanelBackgroundBrush}"
            BorderBrush="{ThemeResource PanelBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <MenuBar Height="36" VerticalAlignment="Center">
                    <MenuBarItem x:Uid="FileMenu" AutomationProperties.AutomationId="FileMenuBarItem">
                        <MenuFlyoutItem
                            x:Uid="MenuFileNew"
                            AutomationProperties.AutomationId="NewDocumentMenuItem"
                            Click="NewDocumentMenuItem_Click"
                            KeyboardAcceleratorTextOverride="Ctrl+N" />
                        <MenuFlyoutItem
                            x:Uid="MenuFileOpen"
                            AutomationProperties.AutomationId="OpenProjectMenuItem"
                            Click="OpenDocumentMenuItem_Click"
                            KeyboardAcceleratorTextOverride="Ctrl+O" />
                        <MenuFlyoutItem
                            x:Uid="MenuFileSave"
                            AutomationProperties.AutomationId="SaveProjectMenuItem"
                            Click="SaveButton_Click"
                            KeyboardAcceleratorTextOverride="Ctrl+S" />
                        <MenuFlyoutItem
                            x:Uid="MenuFileSaveAs"
                            AutomationProperties.AutomationId="SaveProjectAsMenuItem"
                            Click="SaveAsMenuItem_Click"
                            KeyboardAcceleratorTextOverride="Ctrl+Shift+S" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            x:Uid="MenuFileExport"
                            AutomationProperties.AutomationId="ExportPngMenuItem"
                            Click="ExportButton_Click"
                            KeyboardAcceleratorTextOverride="Ctrl+E" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutSubItem
                            x:Name="RecentProjectsMenu"
                            x:Uid="MenuFileRecent"
                            AutomationProperties.AutomationId="RecentProjectsMenu" />
                    </MenuBarItem>

                    <MenuBarItem x:Uid="EditMenu" AutomationProperties.AutomationId="EditMenuBarItem">
                        <MenuFlyoutItem
                            x:Uid="MenuEditUndo"
                            Command="{x:Bind ViewModel.UndoCommand}"
                            KeyboardAcceleratorTextOverride="Ctrl+Z" />
                        <MenuFlyoutItem
                            x:Uid="MenuEditRedo"
                            Command="{x:Bind ViewModel.RedoCommand}"
                            KeyboardAcceleratorTextOverride="Ctrl+Y" />
                    </MenuBarItem>

                    <MenuBarItem x:Uid="CanvasMenu" AutomationProperties.AutomationId="CanvasMenuBarItem">
                        <MenuFlyoutItem
                            x:Uid="MenuCanvasSize"
                            Click="CanvasSizeButton_Click"
                            KeyboardAcceleratorTextOverride="Ctrl+Alt+C" />
                    </MenuBarItem>

                    <MenuBarItem x:Uid="ViewMenu" AutomationProperties.AutomationId="ViewMenuBarItem">
                        <ToggleMenuFlyoutItem
                            x:Uid="MenuViewGrid"
                            Click="GridToggle_Click"
                            IsChecked="{Binding IsGridVisible, Mode=TwoWay}"
                            KeyboardAcceleratorTextOverride="Ctrl+G" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            x:Uid="MenuViewZoomIn"
                            Click="ZoomInMenuItem_Click"
                            KeyboardAcceleratorTextOverride="Ctrl++" />
                        <MenuFlyoutItem
                            x:Uid="MenuViewZoomOut"
                            Click="ZoomOutMenuItem_Click"
                            KeyboardAcceleratorTextOverride="Ctrl+-" />
                        <MenuFlyoutItem
                            x:Uid="MenuViewZoomReset"
                            Click="ZoomResetMenuItem_Click"
                            KeyboardAcceleratorTextOverride="Ctrl+0" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            x:Uid="MenuViewImmersive"
                            Click="ImmersiveButton_Click"
                            KeyboardAcceleratorTextOverride="Tab" />
                        <MenuFlyoutItem
                            x:Uid="MenuViewFullScreen"
                            Click="FullScreenMenuItem_Click"
                            KeyboardAcceleratorTextOverride="F11" />
                    </MenuBarItem>

                    <MenuBarItem x:Uid="SettingsMenu" AutomationProperties.AutomationId="SettingsMenuBarItem">
                        <MenuFlyoutItem
                            x:Uid="MenuSettingsAppearance"
                            AutomationProperties.AutomationId="AppearanceSettingsMenuItem"
                            Click="SettingsButton_Click"
                            KeyboardAcceleratorTextOverride="Ctrl+," />
                        <MenuFlyoutItem
                            x:Uid="MenuSettingsFileAssociation"
                            AutomationProperties.AutomationId="FileAssociationMenuItem"
                            Click="FileAssociationMenuItem_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuSettingsAbout" AutomationProperties.AutomationId="AboutMenuItem" Click="AboutMenuItem_Click" />
                    </MenuBarItem>
                </MenuBar>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Border
                        Padding="8,4"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="8">
                        <TextBlock
                            x:Name="ActiveToolStatusText"
                            AutomationProperties.LiveSetting="Polite"
                            VerticalAlignment="Center"
                            Style="{ThemeResource CaptionTextBlockStyle}" />
                    </Border>
                    <Button
                        x:Uid="CanvasSizeButton"
                        AutomationProperties.AutomationId="CanvasSizeButton"
                        AutomationProperties.HelpText="{Binding CanvasSizeText}"
                        Click="CanvasSizeButton_Click"
                        Content="{Binding CanvasSizeText}"
                        Style="{StaticResource StatusPillButtonStyle}" />
                    <Button
                        x:Uid="ZoomResetButton"
                        Click="ZoomResetMenuItem_Click"
                        Content="{Binding ZoomText}"
                        Style="{StaticResource StatusPillButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 左側一站式集中繪圖工具列（復原/重做 + 畫筆 + 第二層選單） -->
        <Border
            x:Name="ToolBar"
            Grid.Row="1"
            Background="{ThemeResource PanelBackgroundBrush}"
            BorderBrush="{ThemeResource PanelBorderBrush}"
            BorderThickness="0,0,1,0">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled">
                <StackPanel Padding="0,8">
                    <!-- 復原 / 重做與畫筆集中放在一起 -->
                    <Button
                        x:Uid="UndoButton"
                        AutomationProperties.AutomationId="UndoButton"
                        Command="{Binding UndoCommand}"
                        Content="&#xE7A7;"
                        Style="{StaticResource ToolButtonStyle}" />
                    <Button
                        x:Uid="RedoButton"
                        AutomationProperties.AutomationId="RedoButton"
                        Command="{Binding RedoCommand}"
                        Content="&#xE7A6;"
                        Style="{StaticResource ToolButtonStyle}" />

                    <Rectangle Height="1" Margin="8,4" Fill="{ThemeResource PanelBorderBrush}" />

                    <!-- 常用第一層畫筆：原子筆、鉛筆、螢光筆 -->
                    <Button
                        x:Name="BallpointToolButton"
                        x:Uid="BallpointTool"
                        Click="ToolButton_Click"
                        Style="{StaticResource ToolButtonStyle}"
                        Tag="Ballpoint">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path
                                    Data="M 9.5,3 H 14.5 V 12.5 L 12,18.5 L 9.5,12.5 Z"
                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                    StrokeLineJoin="Round"
                                    StrokeThickness="1.8" />
                                <Path
                                    Data="M 14.5,5.5 H 17.5 V 10.5"
                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeThickness="1.8" />
                                <Ellipse
                                    Canvas.Left="10.7"
                                    Canvas.Top="18.8"
                                    Width="2.6"
                                    Height="2.6"
                                    Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Button
                        x:Name="PencilToolButton"
                        x:Uid="PencilTool"
                        Click="ToolButton_Click"
                        Style="{StaticResource ToolButtonStyle}"
                        Tag="Pencil">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path
                                    Data="M 16.5,3.5 L 20.5,7.5 L 8.5,19.5 L 3.5,20.5 L 4.5,15.5 Z"
                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                    StrokeLineJoin="Round"
                                    StrokeThickness="1.8" />
                                <Line
                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                    StrokeThickness="1.8"
                                    X1="14"
                                    X2="18"
                                    Y1="6"
                                    Y2="10" />
                                <Line
                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                    StrokeThickness="1.8"
                                    X1="4.5"
                                    X2="8.5"
                                    Y1="15.5"
                                    Y2="19.5" />
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Button
                        x:Name="HighlighterToolButton"
                        x:Uid="HighlighterTool"
                        Click="ToolButton_Click"
                        Style="{StaticResource ToolButtonStyle}"
                        Tag="Highlighter">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path
                                    Data="M 14.5,2.5 L 20.5,8.5 L 13,16 L 7,10 Z"
                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                    StrokeLineJoin="Round"
                                    StrokeThickness="1.8" />
                                <Path
                                    Data="M 7.8,10.8 L 4.5,14.5 L 6.5,17.5 L 12.2,15.2"
                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.8" />
                                <Line
                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="2.8"
                                    X1="4"
                                    X2="20"
                                    Y1="21"
                                    Y2="21" />
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- 第二層畫筆選單按鈕（馬克筆、噴槍、鋼筆、蠟筆、書法筆） -->
                    <Button
                        x:Name="MoreBrushesButton"
                        x:Uid="MoreBrushesButton"
                        AutomationProperties.AutomationId="MoreBrushesButton"
                        Style="{StaticResource ToolButtonStyle}">
                        <Grid Width="44" Height="40">
                            <Viewbox x:Name="MoreIconPen" Width="20" Height="20" Visibility="Collapsed">
                                <Canvas Width="24" Height="24">
                                    <Path
                                        Data="M 12,2.5 L 6.5,11.5 L 9,18 H 15 L 17.5,11.5 Z"
                                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.8" />
                                    <Line
                                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.8"
                                        X1="12"
                                        X2="12"
                                        Y1="2.5"
                                        Y2="10.5" />
                                    <Ellipse
                                        Canvas.Left="10.6"
                                        Canvas.Top="10.6"
                                        Width="2.8"
                                        Height="2.8"
                                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                        StrokeThickness="1.6" />
                                    <Path
                                        Data="M 8,18 H 16 V 21 H 8 Z"
                                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.8" />
                                </Canvas>
                            </Viewbox>

                            <Viewbox x:Name="MoreIconCalligraphy" Width="20" Height="20" Visibility="Collapsed">
                                <Canvas Width="24" Height="24">
                                    <Path
                                        Data="M 16,2.5 L 20.5,5.5 L 13.5,16.5 L 6.5,19.5 L 8.5,12.5 Z"
                                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.8" />
                                    <Path
                                        Data="M 5,21 C 8,22 13,18.5 19.5,20.5"
                                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.8" />
                                </Canvas>
                            </Viewbox>

                            <Viewbox x:Name="MoreIconMarker" Width="20" Height="20" Visibility="Collapsed">
                                <Canvas Width="24" Height="24">
                                    <Path
                                        Data="M 8,9 H 16 V 20.5 H 8 Z"
                                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.8" />
                                    <Line
                                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                        StrokeThickness="1.8"
                                        X1="8"
                                        X2="16"
                                        Y1="13"
                                        Y2="13" />
                                    <Path
                                        Data="M 9.8,9 V 5.2 L 12,3 L 14.2,5.2 V 9"
                                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.8" />
                                </Canvas>
                            </Viewbox>

                            <Viewbox x:Name="MoreIconAirbrush" Width="20" Height="20" Visibility="Visible">
                                <Canvas Width="24" Height="24">
                                    <Path
                                        Data="M 10.5,10.5 L 19.5,6 L 21.5,10 L 12.5,14.5 Z"
                                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.8" />
                                    <Path
                                        Data="M 10.5,10.5 L 7.5,12.5 L 8.3,14.2 L 12.5,14.5"
                                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.8" />
                                    <Line
                                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.8"
                                        X1="14.5"
                                        X2="16.5"
                                        Y1="13.5"
                                        Y2="19.5" />
                                    <Ellipse Canvas.Left="3.8" Canvas.Top="8.2" Width="2.2" Height="2.2" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <Ellipse Canvas.Left="1.8" Canvas.Top="11.8" Width="2.4" Height="2.4" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <Ellipse Canvas.Left="4.5" Canvas.Top="13.8" Width="2.2" Height="2.2" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <Ellipse Canvas.Left="2.2" Canvas.Top="16.2" Width="2.0" Height="2.0" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                </Canvas>
                            </Viewbox>

                            <Viewbox x:Name="MoreIconCrayon" Width="20" Height="20" Visibility="Collapsed">
                                <Canvas Width="24" Height="24">
                                    <Path
                                        Data="M 8.5,8.5 H 15.5 V 21 H 8.5 Z"
                                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.8" />
                                    <Path
                                        Data="M 9.2,8.5 L 11,3 H 13 L 14.8,8.5"
                                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.8" />
                                    <Line
                                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                        StrokeThickness="1.8"
                                        X1="8.5"
                                        X2="15.5"
                                        Y1="12"
                                        Y2="12" />
                                    <Line
                                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                        StrokeThickness="1.8"
                                        X1="8.5"
                                        X2="15.5"
                                        Y1="17.5"
                                        Y2="17.5" />
                                </Canvas>
                            </Viewbox>

                            <Polygon
                                Margin="0,0,4,4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                Points="0,5 5,5 5,0" />
                        </Grid>

                        <Button.Flyout>
                            <Flyout x:Name="MoreBrushesFlyout" Opening="Flyout_Opening" Placement="RightEdgeAlignedTop">
                                <StackPanel x:Name="MoreBrushesFlyoutRoot" Width="168" Spacing="4">
                                    <TextBlock
                                        x:Uid="MoreBrushesSectionTitle"
                                        Margin="8,4"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />

                                    <Button
                                        x:Name="MarkerToolButton"
                                        x:Uid="MarkerTool"
                                        Click="SecondaryBrushButton_Click"
                                        Style="{StaticResource SecondaryBrushButtonStyle}"
                                        Tag="Marker">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Viewbox Width="18" Height="18">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M 8,9 H 16 V 20.5 H 8 Z" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeLineJoin="Round" StrokeThickness="1.8" />
                                                    <Line Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.8" X1="8" X2="16" Y1="13" Y2="13" />
                                                    <Path Data="M 9.8,9 V 5.2 L 12,3 L 14.2,5.2 V 9" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeLineJoin="Round" StrokeThickness="1.8" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock x:Uid="MarkerToolLabel" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="AirbrushToolButton"
                                        x:Uid="AirbrushTool"
                                        Click="SecondaryBrushButton_Click"
                                        Style="{StaticResource SecondaryBrushButtonStyle}"
                                        Tag="Airbrush">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Viewbox Width="18" Height="18">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M 10.5,10.5 L 19.5,6 L 21.5,10 L 12.5,14.5 Z" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeLineJoin="Round" StrokeThickness="1.8" />
                                                    <Path Data="M 10.5,10.5 L 7.5,12.5 L 8.3,14.2 L 12.5,14.5" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeLineJoin="Round" StrokeThickness="1.8" />
                                                    <Line Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeThickness="1.8" X1="14.5" X2="16.5" Y1="13.5" Y2="19.5" />
                                                    <Ellipse Canvas.Left="3.8" Canvas.Top="8.2" Width="2.2" Height="2.2" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    <Ellipse Canvas.Left="1.8" Canvas.Top="11.8" Width="2.4" Height="2.4" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    <Ellipse Canvas.Left="4.5" Canvas.Top="13.8" Width="2.2" Height="2.2" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    <Ellipse Canvas.Left="2.2" Canvas.Top="16.2" Width="2.0" Height="2.0" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock x:Uid="AirbrushToolLabel" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="PenToolButton"
                                        x:Uid="PenTool"
                                        Click="SecondaryBrushButton_Click"
                                        Style="{StaticResource SecondaryBrushButtonStyle}"
                                        Tag="Pen">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Viewbox Width="18" Height="18">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M 12,2.5 L 6.5,11.5 L 9,18 H 15 L 17.5,11.5 Z" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeLineJoin="Round" StrokeThickness="1.8" />
                                                    <Line Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeThickness="1.8" X1="12" X2="12" Y1="2.5" Y2="10.5" />
                                                    <Ellipse Canvas.Left="10.6" Canvas.Top="10.6" Width="2.8" Height="2.8" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.6" />
                                                    <Path Data="M 8,18 H 16 V 21 H 8 Z" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeLineJoin="Round" StrokeThickness="1.8" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock x:Uid="PenToolLabel" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="CrayonToolButton"
                                        x:Uid="CrayonTool"
                                        Click="SecondaryBrushButton_Click"
                                        Style="{StaticResource SecondaryBrushButtonStyle}"
                                        Tag="Crayon">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Viewbox Width="18" Height="18">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M 8.5,8.5 H 15.5 V 21 H 8.5 Z" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeLineJoin="Round" StrokeThickness="1.8" />
                                                    <Path Data="M 9.2,8.5 L 11,3 H 13 L 14.8,8.5" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeLineJoin="Round" StrokeThickness="1.8" />
                                                    <Line Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.8" X1="8.5" X2="15.5" Y1="12" Y2="12" />
                                                    <Line Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.8" X1="8.5" X2="15.5" Y1="17.5" Y2="17.5" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock x:Uid="CrayonToolLabel" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="CalligraphyToolButton"
                                        x:Uid="CalligraphyTool"
                                        Click="SecondaryBrushButton_Click"
                                        Style="{StaticResource SecondaryBrushButtonStyle}"
                                        Tag="Calligraphy">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Viewbox Width="18" Height="18">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M 16,2.5 L 20.5,5.5 L 13.5,16.5 L 6.5,19.5 L 8.5,12.5 Z" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeLineJoin="Round" StrokeThickness="1.8" />
                                                    <Path Data="M 5,21 C 8,22 13,18.5 19.5,20.5" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeThickness="1.8" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock x:Uid="CalligraphyToolLabel" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>



                    <!-- 橡皮擦與十字四向箭頭平移工具 -->
                    <Button
                        x:Name="EraserToolButton"
                        x:Uid="EraserTool"
                        Click="ToolButton_Click"
                        Style="{StaticResource ToolButtonStyle}"
                        Tag="Eraser">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path
                                    Data="M 14.5,3.5 L 20.5,9.5 L 11.5,18.5 H 6.5 L 3.5,15.5 Z"
                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                    StrokeLineJoin="Round"
                                    StrokeThickness="1.8" />
                                <Line
                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                    StrokeThickness="1.8"
                                    X1="9.5"
                                    X2="15.5"
                                    Y1="8.5"
                                    Y2="14.5" />
                                <Line
                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.8"
                                    X1="11"
                                    X2="20.5"
                                    Y1="20.5"
                                    Y2="20.5" />
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Button
                        x:Name="FavoriteBrushesButton"
                        x:Uid="FavoriteBrushesButton"
                        AutomationProperties.AutomationId="FavoriteBrushesButton"
                        Content="&#xE734;"
                        Style="{StaticResource ToolButtonStyle}">
                        <Button.Flyout>
                            <Flyout
                                x:Name="FavoriteBrushesFlyout"
                                Closed="ToolFlyout_Closed"
                                Opening="Flyout_Opening"
                                Placement="RightEdgeAlignedTop">
                                <StackPanel x:Name="FavoriteBrushesFlyoutRoot" Width="264" Spacing="8">
                                    <TextBlock
                                        x:Uid="FavoriteBrushesSectionTitle"
                                        Margin="8,4"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <Button
                                        x:Name="SaveCurrentFavoriteBrushButton"
                                        x:Uid="SaveCurrentFavoriteBrushButton"
                                        AutomationProperties.AutomationId="SaveCurrentFavoriteBrushButton"
                                        Click="SaveCurrentFavoriteBrushButton_Click"
                                        IsEnabled="{Binding CanSaveCurrentBrush}"
                                        Style="{StaticResource SecondaryBrushButtonStyle}" />
                                    <TextBlock
                                        x:Name="FavoriteBrushEmptyState"
                                        x:Uid="FavoriteBrushEmptyState"
                                        Margin="8,12"
                                        HorizontalAlignment="Center"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl
                                            x:Name="FavoriteBrushList"
                                            AutomationProperties.AutomationId="FavoriteBrushList"
                                            ItemsSource="{Binding FavoriteBrushes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2" ColumnSpacing="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button
                                                            Grid.Column="0"
                                                            AutomationProperties.AutomationId="FavoriteApplyButton"
                                                            AutomationProperties.Name="{Binding Name}"
                                                            Click="ApplyFavoriteBrushButton_Click"
                                                            Content="{Binding Name}"
                                                            Style="{StaticResource SecondaryBrushButtonStyle}" />
                                                        <Button
                                                            x:Uid="MoveFavoriteBrushUpButton"
                                                            AutomationProperties.AutomationId="FavoriteMoveUpButton"
                                                            Grid.Column="1"
                                                            Click="MoveFavoriteBrushUpButton_Click"
                                                            Content="&#xE70E;"
                                                            Style="{StaticResource CompactIconButtonStyle}" />
                                                        <Button
                                                            x:Uid="MoveFavoriteBrushDownButton"
                                                            AutomationProperties.AutomationId="FavoriteMoveDownButton"
                                                            Grid.Column="2"
                                                            Click="MoveFavoriteBrushDownButton_Click"
                                                            Content="&#xE70D;"
                                                            Style="{StaticResource CompactIconButtonStyle}" />
                                                        <Button
                                                            x:Uid="RenameFavoriteBrushButton"
                                                            AutomationProperties.AutomationId="FavoriteRenameButton"
                                                            Grid.Column="3"
                                                            Click="RenameFavoriteBrushButton_Click"
                                                            Content="&#xE70F;"
                                                            Style="{StaticResource CompactIconButtonStyle}" />
                                                        <Button
                                                            x:Uid="DeleteFavoriteBrushButton"
                                                            AutomationProperties.AutomationId="FavoriteDeleteButton"
                                                            Grid.Column="4"
                                                            Click="DeleteFavoriteBrushButton_Click"
                                                            Content="&#xE74D;"
                                                            Style="{StaticResource CompactIconButtonStyle}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button
                        x:Name="PanToolButton"
                        x:Uid="PanTool"
                        Click="ToolButton_Click"
                        Style="{StaticResource ToolButtonStyle}"
                        Tag="Pan">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Line Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeThickness="1.8" X1="3" X2="21" Y1="12" Y2="12" />
                                <Line Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeThickness="1.8" X1="12" X2="12" Y1="3" Y2="21" />
                                <Path Data="M 9,6 L 12,3 L 15,6" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.8" />
                                <Path Data="M 9,18 L 12,21 L 15,18" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.8" />
                                <Path Data="M 6,9 L 3,12 L 6,15" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.8" />
                                <Path Data="M 18,9 L 21,12 L 18,15" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.8" />
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Rectangle Height="1" Margin="8,4" Fill="{ThemeResource PanelBorderBrush}" />

                    <!-- 第二層彈出面板：筆刷設定、顏色、圖層 -->
                    <Button
                        x:Uid="BrushSettingsButton"
                        AutomationProperties.AutomationId="BrushSettingsButton"
                        Style="{StaticResource ToolButtonStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                            <Ellipse
                                Width="{Binding BrushPreviewSize}"
                                Height="{Binding BrushPreviewSize}"
                                HorizontalAlignment="Center"
                                Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{Binding BrushSizeText}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout
                                x:Name="BrushSettingsFlyout"
                                Closed="ToolFlyout_Closed"
                                Opening="BrushSettingsFlyout_Opening"
                                Placement="RightEdgeAlignedTop">
                                <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="BrushSettingsFlyoutRoot" Width="248" Spacing="12">
                                        <TextBlock x:Uid="BrushSectionTitle" Style="{ThemeResource SubtitleTextBlockStyle}" />

                                        <Grid>
                                            <TextBlock x:Uid="BrushSizeLabel" />
                                            <TextBlock HorizontalAlignment="Right" Text="{Binding BrushSizeText}" />
                                        </Grid>
                                        <Slider
                                            x:Uid="BrushSizeSlider"
                                            Maximum="80"
                                            Minimum="1"
                                            StepFrequency="1"
                                            Value="{Binding BrushSize, Mode=TwoWay}" />

                                        <Grid>
                                            <TextBlock x:Uid="OpacityLabel" />
                                            <TextBlock HorizontalAlignment="Right" Text="{Binding BrushOpacityText}" />
                                        </Grid>
                                        <Slider
                                            x:Uid="OpacitySlider"
                                            Maximum="1"
                                            Minimum="0.05"
                                            StepFrequency="0.05"
                                            Value="{Binding BrushOpacity, Mode=TwoWay}" />

                                        <CheckBox x:Uid="SizePressureCheckBox" IsChecked="{Binding UseSizePressure, Mode=TwoWay}" />
                                        <CheckBox x:Uid="OpacityPressureCheckBox" IsChecked="{Binding UseOpacityPressure, Mode=TwoWay}" />

                                        <StackPanel x:Name="SoftnessPanel" Spacing="8">
                                            <Grid>
                                                <TextBlock x:Uid="SoftnessLabel" />
                                                <TextBlock HorizontalAlignment="Right" Text="{Binding BrushSoftnessText}" />
                                            </Grid>
                                            <Slider
                                                x:Uid="SoftnessSlider"
                                                AutomationProperties.AutomationId="SoftnessSlider"
                                                Maximum="1"
                                                Minimum="0"
                                                StepFrequency="0.05"
                                                Value="{Binding BrushSoftness, Mode=TwoWay}" />
                                        </StackPanel>

                                        <StackPanel x:Name="FlowPanel" Spacing="8">
                                            <Grid>
                                                <TextBlock x:Uid="FlowLabel" />
                                                <TextBlock HorizontalAlignment="Right" Text="{Binding BrushFlowText}" />
                                            </Grid>
                                            <Slider
                                                x:Uid="FlowSlider"
                                                AutomationProperties.AutomationId="FlowSlider"
                                                Maximum="1"
                                                Minimum="0.05"
                                                StepFrequency="0.05"
                                                Value="{Binding BrushFlow, Mode=TwoWay}" />
                                        </StackPanel>

                                        <StackPanel x:Name="AirbrushModePanel" Spacing="8">
                                            <TextBlock x:Uid="AirbrushModeLabel" />
                                            <ComboBox
                                                x:Name="AirbrushModeComboBox"
                                                x:Uid="AirbrushModeComboBox"
                                                AutomationProperties.AutomationId="AirbrushModeComboBox"
                                                HorizontalAlignment="Stretch"
                                                SelectionChanged="AirbrushModeComboBox_SelectionChanged">
                                                <ComboBoxItem Content="Mist" AutomationProperties.AutomationId="AirbrushModeMistItem" />
                                                <ComboBoxItem Content="Grain" AutomationProperties.AutomationId="AirbrushModeGrainItem" />
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel x:Name="PressureCurvePanel" Spacing="8">
                                            <TextBlock x:Uid="PressureCurveLabel" />
                                            <ComboBox
                                                x:Name="PressureCurveComboBox"
                                                x:Uid="PressureCurveComboBox"
                                                AutomationProperties.AutomationId="PressureCurveComboBox"
                                                HorizontalAlignment="Stretch"
                                                SelectionChanged="PressureCurveComboBox_SelectionChanged">
                                                <ComboBoxItem Content="Soft" AutomationProperties.AutomationId="PressureCurveSoftItem" />
                                                <ComboBoxItem Content="Linear" AutomationProperties.AutomationId="PressureCurveLinearItem" />
                                                <ComboBoxItem Content="Hard" AutomationProperties.AutomationId="PressureCurveHardItem" />
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button
                        x:Uid="ColorFlyoutButton"
                        AutomationProperties.AutomationId="ColorFlyoutButton"
                        Style="{StaticResource ToolButtonStyle}">
                        <Ellipse
                            Width="22"
                            Height="22"
                            Stroke="{ThemeResource PanelBorderBrush}"
                            StrokeThickness="1.5">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding SelectedColor}" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <Button.Flyout>
                            <Flyout
                                x:Name="ColorFlyout"
                                Closed="ToolFlyout_Closed"
                                Opening="Flyout_Opening"
                                Placement="RightEdgeAlignedBottom">
                                <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="ColorFlyoutRoot" Width="244" Spacing="12">
                                        <TextBlock x:Uid="ColorSectionTitle" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <Grid Margin="4,0" ColumnSpacing="8" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="32" />
                                                <RowDefinition Height="32" />
                                                <RowDefinition Height="32" />
                                                <RowDefinition Height="32" />
                                            </Grid.RowDefinitions>
                                            <Button x:Uid="InkSwatch" AutomationProperties.AutomationId="SwatchInk" Grid.Row="0" Grid.Column="0" Background="{StaticResource SwatchInkBrush}" Click="Swatch_Click" Style="{StaticResource SwatchButtonStyle}" />
                                            <Button x:Uid="WhiteSwatch" AutomationProperties.AutomationId="SwatchWhite" Grid.Row="0" Grid.Column="1" Background="{StaticResource SwatchWhiteBrush}" Click="Swatch_Click" Style="{StaticResource SwatchButtonStyle}" />
                                            <Button x:Uid="RedSwatch" AutomationProperties.AutomationId="SwatchRed" Grid.Row="0" Grid.Column="2" Background="{StaticResource SwatchRedBrush}" Click="Swatch_Click" Style="{StaticResource SwatchButtonStyle}" />
                                            <Button x:Uid="OrangeSwatch" AutomationProperties.AutomationId="SwatchOrange" Grid.Row="0" Grid.Column="3" Background="{StaticResource SwatchOrangeBrush}" Click="Swatch_Click" Style="{StaticResource SwatchButtonStyle}" />
                                            <Button x:Uid="YellowSwatch" AutomationProperties.AutomationId="SwatchYellow" Grid.Row="1" Grid.Column="0" Background="{StaticResource SwatchYellowBrush}" Click="Swatch_Click" Style="{StaticResource SwatchButtonStyle}" />
                                            <Button x:Uid="GreenSwatch" AutomationProperties.AutomationId="SwatchGreen" Grid.Row="1" Grid.Column="1" Background="{StaticResource SwatchGreenBrush}" Click="Swatch_Click" Style="{StaticResource SwatchButtonStyle}" />
                                            <Button x:Uid="TealSwatch" AutomationProperties.AutomationId="SwatchTeal" Grid.Row="1" Grid.Column="2" Background="{StaticResource SwatchTealBrush}" Click="Swatch_Click" Style="{StaticResource SwatchButtonStyle}" />
                                            <Button x:Uid="CyanSwatch" AutomationProperties.AutomationId="SwatchCyan" Grid.Row="1" Grid.Column="3" Background="{StaticResource SwatchCyanBrush}" Click="Swatch_Click" Style="{StaticResource SwatchButtonStyle}" />
                                            <Button x:Uid="BlueSwatch" AutomationProperties.AutomationId="SwatchBlue" Grid.Row="2" Grid.Column="0" Background="{StaticResource SwatchBlueBrush}" Click="Swatch_Click" Style="{StaticResource SwatchButtonStyle}" />
                                            <Button x:Uid="IndigoSwatch" AutomationProperties.AutomationId="SwatchIndigo" Grid.Row="2" Grid.Column="1" Background="{StaticResource SwatchIndigoBrush}" Click="Swatch_Click" Style="{StaticResource SwatchButtonStyle}" />
                                            <Button x:Uid="PurpleSwatch" AutomationProperties.AutomationId="SwatchPurple" Grid.Row="2" Grid.Column="2" Background="{StaticResource SwatchPurpleBrush}" Click="Swatch_Click" Style="{StaticResource SwatchButtonStyle}" />
                                            <Button x:Uid="PinkSwatch" AutomationProperties.AutomationId="SwatchPink" Grid.Row="2" Grid.Column="3" Background="{StaticResource SwatchPinkBrush}" Click="Swatch_Click" Style="{StaticResource SwatchButtonStyle}" />
                                            <Button x:Uid="BrownSwatch" AutomationProperties.AutomationId="SwatchBrown" Grid.Row="3" Grid.Column="0" Background="{StaticResource SwatchBrownBrush}" Click="Swatch_Click" Style="{StaticResource SwatchButtonStyle}" />
                                            <Button x:Uid="SlateSwatch" AutomationProperties.AutomationId="SwatchSlate" Grid.Row="3" Grid.Column="1" Background="{StaticResource SwatchSlateBrush}" Click="Swatch_Click" Style="{StaticResource SwatchButtonStyle}" />
                                            <Button x:Uid="GraySwatch" AutomationProperties.AutomationId="SwatchGray" Grid.Row="3" Grid.Column="2" Background="{StaticResource SwatchGrayBrush}" Click="Swatch_Click" Style="{StaticResource SwatchButtonStyle}" />
                                            <Button x:Uid="MistSwatch" AutomationProperties.AutomationId="SwatchMist" Grid.Row="3" Grid.Column="3" Background="{StaticResource SwatchMistBrush}" Click="Swatch_Click" Style="{StaticResource SwatchButtonStyle}" />
                                            <Button x:Uid="AmberSwatch" AutomationProperties.AutomationId="SwatchAmber" Grid.Row="0" Grid.Column="4" Background="{StaticResource SwatchAmberBrush}" Click="Swatch_Click" Style="{StaticResource SwatchButtonStyle}" />
                                            <Button x:Uid="LimeSwatch" AutomationProperties.AutomationId="SwatchLime" Grid.Row="1" Grid.Column="4" Background="{StaticResource SwatchLimeBrush}" Click="Swatch_Click" Style="{StaticResource SwatchButtonStyle}" />
                                            <Button x:Uid="SkySwatch" AutomationProperties.AutomationId="SwatchSky" Grid.Row="2" Grid.Column="4" Background="{StaticResource SwatchSkyBrush}" Click="Swatch_Click" Style="{StaticResource SwatchButtonStyle}" />
                                            <Button x:Uid="RoseSwatch" AutomationProperties.AutomationId="SwatchRose" Grid.Row="3" Grid.Column="4" Background="{StaticResource SwatchRoseBrush}" Click="Swatch_Click" Style="{StaticResource SwatchButtonStyle}" />
                                        </Grid>

                                        <Expander
                                            x:Uid="CustomColorExpander"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center">
                                            <ColorPicker
                                                x:Uid="ColorPicker"
                                                IsAlphaEnabled="False"
                                                IsColorChannelTextInputVisible="False"
                                                IsColorSliderVisible="True"
                                                IsHexInputVisible="True"
                                                IsMoreButtonVisible="False"
                                                Color="{Binding SelectedColor, Mode=TwoWay}" />
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button
                        x:Uid="LayersFlyoutButton"
                        AutomationProperties.AutomationId="LayersFlyoutButton"
                        Style="{StaticResource ToolButtonStyle}">
                        <Grid Width="40" Height="36">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,3 L 2.5,8 L 12,13 L 21.5,8 Z" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeLineJoin="Round" StrokeThickness="1.8" />
                                    <Path Data="M 2.5,12.5 L 12,17.5 L 21.5,12.5" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.8" />
                                    <Path Data="M 2.5,17 L 12,22 L 21.5,17" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.8" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock
                                Margin="0,0,2,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{Binding LayerCountText}" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout
                                x:Name="LayersFlyout"
                                Closed="ToolFlyout_Closed"
                                Opening="Flyout_Opening"
                                Placement="RightEdgeAlignedBottom">
                                <StackPanel x:Name="LayersFlyoutRoot" Width="256" Spacing="8">
                                    <Grid>
                                        <TextBlock x:Uid="LayerSectionTitle" VerticalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <Button
                                            x:Uid="AddLayerButton"
                                            HorizontalAlignment="Right"
                                            AutomationProperties.AutomationId="AddLayerButton"
                                            Click="AddLayerButton_Click"
                                            Content="&#xE710;"
                                            Style="{StaticResource CompactIconButtonStyle}" />
                                    </Grid>
                                    <ListView
                                        x:Name="LayerList"
                                        MaxHeight="180"
                                        AutomationProperties.AutomationId="LayerList"
                                        SelectionChanged="LayerList_SelectionChanged">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                        <TextBox x:Uid="LayerNameEditor" AutomationProperties.AutomationId="LayerNameEditor" Text="{Binding SelectedItem.Name, ElementName=LayerList, Mode=TwoWay}" />
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <CheckBox x:Uid="LayerVisibleCheckBox" IsChecked="{Binding SelectedItem.IsVisible, ElementName=LayerList, Mode=TwoWay}" />
                                        <CheckBox x:Uid="LayerLockedCheckBox" IsChecked="{Binding SelectedItem.IsLocked, ElementName=LayerList, Mode=TwoWay}" />
                                    </StackPanel>
                                    <Slider
                                        x:Uid="LayerOpacitySlider"
                                        Maximum="1"
                                        Minimum="0"
                                        StepFrequency="0.01"
                                        Value="{Binding SelectedItem.Opacity, ElementName=LayerList, Mode=TwoWay}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button x:Uid="LayerUpButton" Click="LayerUpButton_Click" Content="&#xE70E;" Style="{StaticResource CompactIconButtonStyle}" />
                                        <Button x:Uid="LayerDownButton" Click="LayerDownButton_Click" Content="&#xE70D;" Style="{StaticResource CompactIconButtonStyle}" />
                                        <Button x:Uid="DeleteLayerButton" Click="DeleteLayerButton_Click" Content="&#xE74D;" Style="{StaticResource CompactIconButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 極大化繪圖畫布 -->
        <local:CursorGrid x:Name="CanvasWorkspace" Grid.Row="1" Grid.Column="1" Background="{ThemeResource WorkspaceBrush}">
            <canvas:CanvasControl
                x:Name="DrawingCanvas"
                x:Uid="DrawingCanvas"
                Draw="DrawingCanvas_Draw"
                PointerCaptureLost="DrawingCanvas_PointerCaptureLost"
                PointerMoved="DrawingCanvas_PointerMoved"
                PointerPressed="DrawingCanvas_PointerPressed"
                PointerReleased="DrawingCanvas_PointerReleased"
                PointerWheelChanged="DrawingCanvas_PointerWheelChanged" />
            <canvas:CanvasControl
                x:Name="OverlayCanvas"
                Draw="OverlayCanvas_Draw"
                IsHitTestVisible="False" />
            <Border
                Margin="16"
                Padding="8,4"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <TextBlock x:Uid="CanvasHint" Style="{ThemeResource CaptionTextBlockStyle}" />
            </Border>
        </local:CursorGrid>
    </Grid>
</Window>
