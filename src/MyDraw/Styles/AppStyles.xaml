<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFF1F3F5" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFF9FAFB" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#FFD9DEE5" />
            <SolidColorBrush x:Key="WorkspaceBrush" Color="#FFDCE1E7" />
            <SolidColorBrush x:Key="ToolbarSelectedBrush" Color="#FFFFD84D" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF171A1F" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF20242B" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#FF343A44" />
            <SolidColorBrush x:Key="WorkspaceBrush" Color="#FF111318" />
            <SolidColorBrush x:Key="ToolbarSelectedBrush" Color="#FF75621E" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WorkspaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ToolbarSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Thickness x:Key="PanelPadding">12</Thickness>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <SolidColorBrush x:Key="SwatchInkBrush" Color="#FF1F2937" />
    <SolidColorBrush x:Key="SwatchWhiteBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SwatchRedBrush" Color="#FFDC2626" />
    <SolidColorBrush x:Key="SwatchOrangeBrush" Color="#FFF97316" />
    <SolidColorBrush x:Key="SwatchYellowBrush" Color="#FFFACC15" />
    <SolidColorBrush x:Key="SwatchGreenBrush" Color="#FF16A34A" />
    <SolidColorBrush x:Key="SwatchTealBrush" Color="#FF0D9488" />
    <SolidColorBrush x:Key="SwatchCyanBrush" Color="#FF0284C7" />
    <SolidColorBrush x:Key="SwatchBlueBrush" Color="#FF2563EB" />
    <SolidColorBrush x:Key="SwatchIndigoBrush" Color="#FF4F46E5" />
    <SolidColorBrush x:Key="SwatchPurpleBrush" Color="#FF9333EA" />
    <SolidColorBrush x:Key="SwatchPinkBrush" Color="#FFDB2777" />
    <SolidColorBrush x:Key="SwatchBrownBrush" Color="#FF92400E" />
    <SolidColorBrush x:Key="SwatchSlateBrush" Color="#FF64748B" />
    <SolidColorBrush x:Key="SwatchGrayBrush" Color="#FF94A3B8" />
    <SolidColorBrush x:Key="SwatchMistBrush" Color="#FFF1F5F9" />
    <SolidColorBrush x:Key="SwatchAmberBrush" Color="#FFF59E0B" />
    <SolidColorBrush x:Key="SwatchLimeBrush" Color="#FF84CC16" />
    <SolidColorBrush x:Key="SwatchSkyBrush" Color="#FF0EA5E9" />
    <SolidColorBrush x:Key="SwatchRoseBrush" Color="#FFF43F5E" />

    <ControlTemplate x:Key="SelectedToolButtonTemplate" TargetType="Button">
        <ContentPresenter
            Padding="{TemplateBinding Padding}"
            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}"
            Foreground="{TemplateBinding Foreground}" />
    </ControlTemplate>

    <Style x:Key="ToolButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SecondaryBrushButtonStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <ControlTemplate x:Key="SwatchButtonTemplate" TargetType="Button">
        <Grid
            x:Name="SwatchRoot"
            Background="Transparent"
            RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="SwatchScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <ContentPresenter
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" />
            <Border
                x:Name="SwatchHoverRing"
                Margin="-1"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="2"
                CornerRadius="{TemplateBinding CornerRadius}"
                IsHitTestVisible="False"
                Opacity="0" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="0:0:0.12" />
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="SwatchScale"
                                Storyboard.TargetProperty="ScaleX"
                                To="1.04"
                                Duration="0:0:0.12" />
                            <DoubleAnimation
                                Storyboard.TargetName="SwatchScale"
                                Storyboard.TargetProperty="ScaleY"
                                To="1.04"
                                Duration="0:0:0.12" />
                            <DoubleAnimation
                                Storyboard.TargetName="SwatchHoverRing"
                                Storyboard.TargetProperty="Opacity"
                                To="1"
                                Duration="0:0:0.12" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="SwatchScale"
                                Storyboard.TargetProperty="ScaleX"
                                To="0.94"
                                Duration="0:0:0.08" />
                            <DoubleAnimation
                                Storyboard.TargetName="SwatchScale"
                                Storyboard.TargetProperty="ScaleY"
                                To="0.94"
                                Duration="0:0:0.08" />
                            <DoubleAnimation
                                Storyboard.TargetName="SwatchHoverRing"
                                Storyboard.TargetProperty="Opacity"
                                To="1"
                                Duration="0:0:0.08" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="SwatchRoot"
                                Storyboard.TargetProperty="Opacity"
                                To="0.4"
                                Duration="0:0:0.12" />
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style x:Key="SwatchButtonStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource SwatchButtonTemplate}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderBrush" Value="{ThemeResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="StatusPillButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="CompactIconButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
    </Style>
</ResourceDictionary>
