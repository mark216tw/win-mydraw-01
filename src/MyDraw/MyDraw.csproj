<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Com.StudentTools.MyDraw</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MyDraw.ico</ApplicationIcon>
    <Platforms>x64;arm64</Platforms>
    <PlatformTarget Condition="'$(Platform)' == 'arm64'">arm64</PlatformTarget>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'arm64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>

    <DefaultLanguage>zh-Hant</DefaultLanguage>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MyDraw.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\MyDraw.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\MyDraw.svg" />
    <Content Include="Assets\MyDraw-256.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

